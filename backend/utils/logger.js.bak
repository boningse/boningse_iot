const winston = require('winston');
const path = require('path');
const fs = require('fs');

// 确保日志目录存在
const logDir = path.join(__dirname, '../logs');
if (!fs.existsSync(logDir)) {
  fs.mkdirSync(logDir, { recursive: true });
}

// 自定义日志格式
const logFormat = winston.format.combine(
  winston.format.timestamp({
    format: 'YYYY-MM-DD HH:mm:ss'
  }),
  winston.format.errors({ stack: true }),
  winston.format.json(),
  winston.format.printf(({ timestamp, level, message, ...meta }) => {
    let logMessage = `${timestamp} [${level.toUpperCase()}]: ${message}`;
    
    // 添加元数据
    if (Object.keys(meta).length > 0) {
      logMessage += ` | Meta: ${JSON.stringify(meta)}`;
    }
    
    return logMessage;
  })
);

// 控制台格式（开发环境使用）
const consoleFormat = winston.format.combine(
  winston.format.colorize(),
  winston.format.timestamp({
    format: 'HH:mm:ss'
  }),
  winston.format.printf(({ timestamp, level, message, ...meta }) => {
    let logMessage = `${timestamp} ${level}: ${message}`;
    
    // 在开发环境中显示更多详细信息
    if (process.env.NODE_ENV === 'development' && Object.keys(meta).length > 0) {
      logMessage += `\n${JSON.stringify(meta, null, 2)}`;
    }
    
    return logMessage;
  })
);

// 创建传输器
const transports = [];

// 在非生产环境中添加控制台输出
// 修改：在生产环境也添加控制台输出以便调试
transports.push(
  new winston.transports.Console({
    format: consoleFormat,
    level: process.env.LOG_LEVEL || 'debug'
  })
);

// 文件输出 - 所有日志
transports.push(
  new winston.transports.File({
    filename: path.join(logDir, 'app.log'),
    format: logFormat,
    level: 'info',
    maxsize: 5 * 1024 * 1024, // 10MB
    maxFiles: 5,
        zippedArchive: true,
    tailable: true
  })
);

// 文件输出 - 错误日志
transports.push(
  new winston.transports.File({
    filename: path.join(logDir, 'error.log'),
    format: logFormat,
    level: 'error',
    maxsize: 10 * 1024 * 1024, // 10MB
    maxFiles: 5,
    tailable: true
  })
);

// 文件输出 - 访问日志
transports.push(
  new winston.transports.File({
    filename: path.join(logDir, 'access.log'),
    format: logFormat,
    level: 'info',
    maxsize: 10 * 1024 * 1024, // 10MB
    maxFiles: 10,
    tailable: true
  })
);

// 创建主日志器
const logger = winston.createLogger({
  level: process.env.LOG_LEVEL || 'info',
  format: logFormat,
  transports,
  // 处理未捕获的异常
  exceptionHandlers: [
    new winston.transports.File({
      filename: path.join(logDir, 'exceptions.log'),
      format: logFormat,
      maxsize: 10 * 1024 * 1024,
      maxFiles: 3
    })
  ],
  // 处理未处理的Promise拒绝
  rejectionHandlers: [
    new winston.transports.File({
      filename: path.join(logDir, 'rejections.log'),
      format: logFormat,
      maxsize: 10 * 1024 * 1024,
      maxFiles: 3
    })
  ],
  exitOnError: false
});

// 创建专门的访问日志器（用于HTTP请求日志）
const accessLogger = winston.createLogger({
  level: 'info',
  format: winston.format.combine(
    winston.format.timestamp(),
    winston.format.json()
  ),
  transports: [
    new winston.transports.File({
      filename: path.join(logDir, 'access.log'),
      maxsize: 10 * 1024 * 1024,
      maxFiles: 10,
      tailable: true
    })
  ]
});

// 创建专门的MQTT日志器
const mqttLogger = winston.createLogger({
  level: 'info',
  format: logFormat,
  transports: [
    new winston.transports.File({
      filename: path.join(logDir, 'mqtt.log'),
      maxsize: 10 * 1024 * 1024,
      maxFiles: 5,
      tailable: true
    })
  ]
});

// 创建专门的数据库日志器
const dbLogger = winston.createLogger({
  level: 'info',
  format: logFormat,
  transports: [
    new winston.transports.File({
      filename: path.join(logDir, 'database.log'),
      maxsize: 10 * 1024 * 1024,
      maxFiles: 5,
      tailable: true
    })
  ]
});

// 扩展主日志器的功能
class ExtendedLogger {
  constructor(baseLogger) {
    this.logger = baseLogger;
  }

  debug(message, meta = {}) {
    this.logger.debug(message, meta);
  }

  info(message, meta = {}) {
    this.logger.info(message, meta);
  }

  warn(message, meta = {}) {
    this.logger.warn(message, meta);
  }

  error(message, meta = {}) {
    this.logger.error(message, meta);
  }

  // 用户操作日志
  userAction(action, userId, meta = {}) {
    this.logger.info(`用户操作: ${action}`, {
      userId,
      action,
      ...meta
    });
  }

  deviceAction(action, deviceId, meta = {}) {
    this.logger.info(`设备操作: ${action}`, {
      deviceId,
      action,
      ...meta
    });
  }

  mqttEvent(event, meta = {}) {
    this.logger.info(`MQTT事件: ${event}`, {
      event,
      ...meta
    });
  }

  dbQuery(query, duration, meta = {}) {
    this.logger.debug(`数据库查询: ${query}`, {
      query,
      duration,
      ...meta
    });
  }

  apiRequest(method, url, statusCode, duration, meta = {}) {
    this.logger.info(`API请求: ${method} ${url}`, {
      method,
      url,
      statusCode,
      duration,
      ...meta
    });
  }

  security(event, meta = {}) {
    this.logger.warn(`安全事件: ${event}`, {
      event,
      ...meta
    });
  }

  performance(metric, value, meta = {}) {
    this.logger.info(`性能指标: ${metric}=${value}`, {
      metric,
      value,
      ...meta
    });
  }

  // 增强的错误日志方法
  errorWithContext(error, context = {}) {
    const errorInfo = {
      message: error.message,
      stack: error.stack,
      name: error.name,
      ...context
    };
    
    this.logger.error(`错误: ${error.message}`, errorInfo);
  }

  // 业务错误日志 - 新增
  businessError(operation, error, context = {}) {
    const errorInfo = {
      operation,
      errorType: 'business',
      message: error.message,
      stack: error.stack,
      ...context
    };
    
    this.logger.error(`业务操作失败: ${operation} - ${error.message}`, errorInfo);
  }

  // 系统错误日志 - 新增
  systemError(component, error, context = {}) {
    const errorInfo = {
      component,
      errorType: 'system',
      message: error.message,
      stack: error.stack,
      ...context
    };
    
    this.logger.error(`系统错误: ${component} - ${error.message}`, errorInfo);
  }

  // 数据库错误日志 - 新增
  databaseError(operation, error, context = {}) {
    const errorInfo = {
      operation,
      errorType: 'database',
      message: error.message,
      stack: error.stack,
      ...context
    };
    
    this.logger.error(`数据库操作失败: ${operation} - ${error.message}`, errorInfo);
  }

  // API错误日志 - 新增
  apiError(endpoint, method, error, context = {}) {
    const errorInfo = {
      endpoint,
      method,
      errorType: 'api',
      message: error.message,
      stack: error.stack,
      ...context
    };
    
    this.logger.error(`API错误: ${method} ${endpoint} - ${error.message}`, errorInfo);
  }

  // HTTP中间件
  httpMiddleware() {
    return (req, res, next) => {
      const start = Date.now();
      
      // 记录请求开始
      const requestId = Math.random().toString(36).substr(2, 9);
      req.requestId = requestId;
      
      // 监听响应结束
      res.on('finish', () => {
        const duration = Date.now() - start;
        
        this.apiRequest(
          req.method,
          req.originalUrl || req.url,
          res.statusCode,
          duration,
          {
            requestId,
            userAgent: req.get('User-Agent'),
            ip: req.ip || req.connection.remoteAddress,
            userId: req.user ? req.user.id : null,
            tenantId: req.user ? req.user.tenant_id : null
          }
        );
      });
      
      next();
    };
  }

  // 获取日志统计
  async getLogStats(hours = 24) {
    try {
      const logFile = path.join(logDir, 'app.log');
      const stats = await fs.promises.stat(logFile);
      
      return {
        logFile,
        size: stats.size,
        modified: stats.mtime,
        accessible: true
      };
    } catch (error) {
      return {
        logFile: null,
        size: 0,
        modified: null,
        accessible: false,
        error: error.message
      };
    }
  }

  // 清理旧日志
  async cleanupLogs(daysToKeep = 7) {
    try {
      const files = await fs.promises.readdir(logDir);
      const cutoffDate = new Date(Date.now() - daysToKeep * 24 * 60 * 60 * 1000);
      let deletedCount = 0;

      for (const file of files) {
        const filePath = path.join(logDir, file);
        const stats = await fs.promises.stat(filePath);
        
        if (stats.mtime < cutoffDate) {
          await fs.promises.unlink(filePath);
          deletedCount++;
          this.info(`Deleted old log file: ${file}`);
        }
      }

      this.info(`Log cleanup completed`, { deletedCount, daysToKeep });
      return { deletedCount, daysToKeep };
    } catch (error) {
      this.error('Log cleanup failed', { error: error.message });
      throw error;
    }
  }
}

// 创建扩展日志器实例
const extendedLogger = new ExtendedLogger(logger);

// 导出日志器
module.exports = extendedLogger;

// 同时导出原始的winston日志器（如果需要）
module.exports.winston = logger;
module.exports.accessLogger = accessLogger;
module.exports.mqttLogger = mqttLogger;
module.exports.dbLogger = dbLogger;

// 导出日志目录路径
module.exports.logDir = logDir;

// 处理进程退出时的清理
// 注意：信号处理器已移至app.js主文件中统一管理
// exit事件处理器也移至app.js中，避免在模块加载时就注册退出处理
