{
  "name": "德力信分体空调控制器 CAT1.0 JSON",
  "version": "2.01",
  "protocol_type": "json",
  "manufacturer_code": "DLXFTKT",
  "device_type": "空调控制器",
  "description": "SACM6/CAT1.0；按分体空调控制器通讯接口协议 2.01 配置。fXX 为 16 位十六进制寄存器字；下发 args 格式及电流/电量倍率需实机报文核验。",
  "data_parsing_config": {
    "codec": "configured_json",
    "module_type": "air_conditioner",
    "allow_register_literal": true,
    "message_source_topic": "tsrv/SACM6/{imei}",
    "message_match": { "any": [
      { "path": "args", "exists": true },
      { "path": "ICCID", "exists": true },
      { "path": "iccid", "exists": true }
    ] },
    "fields": [
      { "name": "iccid", "path": ["ICCID", "iccid"], "type": "string", "label": "物联网卡 ICCID" },
      { "name": "power_state", "path": "args.f00", "radix": 16, "type": "boolean", "label": "开关机", "register": "40001", "values": { "0": "关机", "1": "开机" } },
      { "name": "running_status", "path": "args.f01", "radix": 16, "type": "boolean", "label": "待机/工作状态", "register": "40002", "values": { "0": "待机", "1": "工作" } },
      { "name": "mode", "path": "args.f02", "radix": 16, "type": "string", "label": "空调模式", "register": "40003", "map": { "0": "cool", "1": "heat", "2": "fan", "3": "dehumidify" }, "values": { "0": "制冷", "1": "制热", "2": "送风", "3": "除湿" } },
      { "name": "fan_speed", "path": "args.f03", "radix": 16, "type": "string", "label": "风速", "register": "40004", "map": { "0": "auto", "1": "low", "2": "medium", "3": "high" }, "values": { "0": "自动", "1": "低速", "2": "中速", "3": "高速" } },
      { "name": "target_temperature", "path": "args.f04", "radix": 16, "type": "number", "scale": 0.1, "unit": "°C", "label": "设定温度", "register": "40005" },
      { "name": "current_temperature", "path": "args.f05", "radix": 16, "type": "number", "scale": 0.1, "unit": "°C", "label": "室内温度", "register": "40006", "readonly": true },
      { "name": "humidity", "path": "args.f06", "radix": 16, "type": "number", "scale": 0.1, "unit": "%", "label": "房间湿度", "register": "40007", "readonly": true },
      { "name": "reserved_f07", "path": "args.f07", "radix": 16, "type": "number", "label": "保留字段 f07（文档未定义）", "register": "40008", "supported": false },
      { "name": "light_state", "path": "args.f08", "radix": 16, "type": "boolean", "label": "灯光开关", "register": "40009" },
      { "name": "current", "path": "args.f09", "radix": 16, "type": "number", "scale": 1, "unit": "A", "label": "实时电流", "register": "40010", "scale_verification": "按实报 0.24 A 原值解析；设备样本单位与文档一致" },
      { "name": "power", "path": "args.f10", "radix": 16, "type": "number", "scale": 1, "unit": "W", "label": "实时功率", "register": "40011" },
      { "name": "energy", "combine_words": { "high_path": "args.f11", "low_path": "args.f12", "fractional_low_is_scaled": true }, "radix": 16, "type": "number", "scale": 1, "unit": "kWh", "label": "累计电量", "register": "40012-40013", "scale_verification": "整数寄存器按高低字合成；实报小数按低字已缩放值读取" },
      { "name": "energy_saving_mode", "path": "args.f13", "radix": 16, "type": "integer", "label": "普通/节能模式", "register": "40014", "values": { "0": "普通", "2": "节能" } },
      { "name": "configuration_status", "path": "args.f14", "radix": 16, "type": "integer", "label": "配置状态", "register": "40015", "values": { "0": "匹配失败", "1": "配置成功", "2": "匹配模式" } },
      { "name": "infrared_code", "path": "args.f15", "radix": 16, "type": "integer", "label": "红外码库代号", "register": "40016" },
      { "name": "temperature_deadband", "path": "args.f16", "radix": 16, "type": "integer", "unit": "°C", "label": "控温回差", "register": "40017" },
      { "name": "temperature_compensation", "path": "args.f17", "radix": 16, "signed_bits": [8, 16], "type": "integer", "unit": "°C", "label": "温度补偿", "register": "40018" },
      { "name": "reserved_f18", "path": "args.f18", "radix": 16, "type": "number", "label": "保留字段 f18（文档未定义）", "register": "40019", "supported": false },
      { "name": "minimum_temperature", "path": "args.f19", "radix": 16, "type": "integer", "unit": "°C", "label": "最低设定温度", "register": "40020" },
      { "name": "maximum_temperature", "path": "args.f20", "radix": 16, "type": "integer", "unit": "°C", "label": "最高设定温度", "register": "40021" },
      { "name": "operating_mode", "path": "args.f21", "radix": 16, "type": "integer", "label": "运行模式配置", "register": "40022" },
      { "name": "cooling_time_coefficient", "path": "args.f22", "radix": 16, "type": "integer", "label": "制冷功率时间系数", "register": "40023" },
      { "name": "heating_time_coefficient", "path": "args.f23", "radix": 16, "type": "integer", "label": "制热功率时间系数", "register": "40024" },
      { "name": "metered_duration", "combine_words": { "high_path": "args.f24", "low_path": "args.f25", "fractional_low_is_scaled": true }, "radix": 16, "type": "number", "label": "累计计量时间", "register": "40025-40026", "unit": "H", "unit_verification": "实报小数值按低字已缩放值读取；单位以计量模式和设备验证为准" },
      { "name": "recharged_duration", "combine_words": { "high_path": "args.f26", "low_path": "args.f27" }, "radix": 16, "type": "number", "label": "累计充值时间", "register": "40027-40028", "unit": "H", "unit_verification": "原始计量单位待实机核验" },
      { "name": "report_interval", "path": "args.f28", "radix": 16, "type": "integer", "unit": "s", "label": "上报轮询间隔", "register": "40029" },
      { "name": "project_number", "path": "args.f29", "radix": 16, "type": "integer", "label": "项目编号", "register": "40030" },
      { "name": "customer_number", "path": "args.f30", "radix": 16, "type": "integer", "label": "客户编号", "register": "40031" },
      { "name": "reserved_f31", "path": "args.f31", "radix": 16, "type": "number", "label": "保留字段 f31（文档未定义）", "register": "40032", "supported": false },
      { "name": "working_current_threshold", "path": "args.f32", "radix": 16, "type": "number", "unit": "A", "label": "工作电流阈值", "register": "40033" },
      { "name": "wind_direction_mode", "path": "args.f33", "radix": 16, "type": "integer", "label": "风向模式", "register": "40034", "values": { "0": "自动", "1": "手动" } },
      { "name": "metering_mode", "path": "args.f34", "radix": 16, "type": "integer", "label": "计量模式", "register": "40035", "values": { "0": "时间型", "1": "电量型" } },
      { "name": "reserved_f35", "path": "args.f35", "radix": 16, "type": "number", "label": "保留字段 f35（文档未定义）", "register": "40036", "supported": false },
      { "name": "signal_strength", "path": "args.f36", "radix": 16, "type": "integer", "label": "信号强度", "register": "40037", "readonly": true },
      { "name": "reserved_f37", "path": "args.f37", "radix": 16, "type": "number", "label": "保留字段 f37（文档未定义）", "register": "40038", "supported": false },
      { "name": "voltage", "path": "args.f38", "radix": 16, "type": "number", "scale": 1, "unit": "V", "label": "采集电压", "register": "40039" },
      { "name": "reserved_f39", "path": "args.f39", "radix": 16, "type": "number", "label": "保留字段 f39（文档未定义）", "register": "40040", "supported": false },
      { "name": "reserved_f40", "path": "args.f40", "radix": 16, "type": "number", "label": "保留字段 f40（文档未定义）", "register": "40041", "supported": false },
      { "name": "reserved_f41", "path": "args.f41", "radix": 16, "type": "number", "label": "保留字段 f41（文档未定义）", "register": "40042", "supported": false },
      { "name": "reserved_f42", "path": "args.f42", "radix": 16, "type": "number", "label": "保留字段 f42（文档未定义）", "register": "40043", "supported": false },
      { "name": "reserved_f43", "path": "args.f43", "radix": 16, "type": "number", "label": "保留字段 f43（文档未定义）", "register": "40044", "supported": false },
      { "name": "phase_mode", "path": "args.f44", "radix": 16, "type": "integer", "label": "单相/三相", "register": "40045", "values": { "0": "单相", "1": "三相" } },
      { "name": "reserved_f45", "path": "args.f45", "radix": 16, "type": "number", "label": "保留字段 f45（文档未定义）", "register": "40046", "supported": false },
      { "name": "error_code", "path": "args.f46", "radix": 16, "type": "integer", "label": "错误码", "register": "40047", "description": "个位传感器、十位红外、百位电量采集故障" },
      { "name": "energy_saving_cool_minimum", "path": "args.f47", "radix": 16, "type": "integer", "unit": "°C", "label": "节能制冷最低设温", "register": "40048" },
      { "name": "energy_saving_heat_maximum", "path": "args.f48", "radix": 16, "type": "integer", "unit": "°C", "label": "节能制热最高设温", "register": "40049" },
      { "name": "energy_saving_trigger_delta", "path": "args.f49", "radix": 16, "type": "number", "scale": 0.1, "unit": "°C", "label": "节能触发温差", "register": "40050" },
      { "name": "energy_saving_trigger_period", "path": "args.f50", "radix": 16, "type": "integer", "unit": "min", "label": "节能触发周期", "register": "40051" },
      { "name": "reserved_f51", "path": "args.f51", "radix": 16, "type": "number", "label": "保留字段 f51（文档未定义）", "register": "40052", "supported": false },
      { "name": "reserved_f52", "path": "args.f52", "radix": 16, "type": "number", "label": "保留字段 f52（文档未定义）", "register": "40053", "supported": false },
      { "name": "reserved_f53", "path": "args.f53", "radix": 16, "type": "number", "label": "保留字段 f53（文档未定义）", "register": "40054", "supported": false }
    ]
  },
  "command_config": {
    "codec": "configured_json",
    "module_type": "air_conditioner",
    "command_format": "register_words",
    "register_value_format": "number",
    "verification_status": "JSON register shape and numeric values follow device report; downlink behavior still requires device confirmation",
    "topicTemplates": { "control": "tcli/SACM6/{imei}" },
    "parameters": {
      "power_state": { "command_field": "power_state", "state_field": "power_status", "state_output_field": "power_status", "state_output_type": "boolean", "values": { "0": 0, "1": 1, "false": 0, "true": 1, "off": 0, "on": 1 } },
      "mode": { "command_field": "mode", "state_field": "mode", "state_output_field": "mode", "values": { "0": 0, "1": 1, "2": 2, "3": 3, "cool": 0, "heat": 1, "fan": 2, "dehumidify": 3, "dry": 3 }, "default": "cool" },
      "fan_speed": { "command_field": "fan_speed", "state_field": "fan_speed", "state_output_field": "fan_speed", "values": { "0": 0, "1": 1, "2": 2, "3": 3, "auto": 0, "low": 1, "medium": 2, "high": 3 }, "default": "auto" },
      "target_temperature": { "command_field": "target_temperature", "state_field": "target_temperature", "state_output_field": "target_temperature", "min": 16, "max": 30, "multiplier": 10, "default": 24 }
    },
    "commands": [
      { "name": "set_power", "description": "开关机", "registers": { "f00": "power_state" }, "payload": { "args": "{registers}" } },
      { "name": "set_mode", "description": "设置模式", "registers": { "f02": "mode" }, "payload": { "args": "{registers}" } },
      { "name": "set_fan_speed", "description": "设置风速", "registers": { "f03": "fan_speed" }, "payload": { "args": "{registers}" } },
      { "name": "set_temperature", "description": "设置目标温度", "registers": { "f04": "target_temperature" }, "payload": { "args": "{registers}" } },
      { "name": "set_operating_state", "description": "一次设置开关、模式、风速、温度", "aggregate": true, "registers": { "f00": "power_state", "f02": "mode", "f03": "fan_speed", "f04": "target_temperature" }, "payload": { "args": "{registers}" } }
    ]
  },
  "validation_rules": { "description": "fXX 为 16 位十六进制寄存器；ICCID 独立上报", "optional_fields": ["iccid"] }
}
