NODE_ENV=production
HOST=127.0.0.1
PORT=3003

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=iot_device_management
DB_USER=postgres
DB_PASSWORD=replace_with_secure_password
DB_DIALECT=postgres

JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=24h

MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_CLIENT_ID=iot-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEP_ALIVE=60
MQTT_CLEAN_SESSION=true

ALLOWED_ORIGINS=https://bnyk.boningse.com,http://127.0.0.1
CORS_ORIGIN=https://bnyk.boningse.com,http://127.0.0.1
ALLOW_NO_ORIGIN=false

REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=iot:

LOG_LEVEL=info
LOG_FILE=logs/backend.log
# High-volume legacy persistence stays disabled unless explicitly re-enabled for diagnostics.
MESSAGE_DETAIL_TRACKING_ENABLED=false
PERSIST_VERBOSE_DEVICE_LOGS=false
MQTT_LOG_LEVEL=info
