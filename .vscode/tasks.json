{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Frontend",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "env": {
          "BACKEND_PORT": "4003"
        }
      },
      "args": ["--", "--port", "4000"],
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(vite v|VITE v).*",
          "endsPattern": ".*ready in.*"
        }
      }
    },
    {
      "label": "Stop Frontend",
      "type": "shell",
      "command": "npx kill-port 4000 || fuser -k 4000/tcp || true",
      "presentation": {
        "reveal": "never"
      }
    }
  ]
}