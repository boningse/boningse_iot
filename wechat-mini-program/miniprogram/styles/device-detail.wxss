.detail-page {
  padding-top: 18rpx;
}

.device-hero {
  padding: 26rpx;
  background: #1d2a24;
  border-radius: 12rpx;
  color: #ffffff;
}

.device-hero__head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.device-hero__copy {
  flex: 1;
  min-width: 0;
}

.device-hero__name,
.device-hero__code {
  display: block;
}

.device-hero__name {
  font-size: 34rpx;
  font-weight: 700;
}

.device-hero__code {
  margin-top: 7rpx;
  color: #aab9b2;
  font-size: 22rpx;
}

.device-hero__meta {
  margin-top: 26rpx;
  padding-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border-top: 1rpx solid #35443d;
  color: #b5c1bb;
  font-size: 21rpx;
}

.device-hero__meta image {
  width: 25rpx;
  height: 25rpx;
  filter: brightness(0) invert(1);
  opacity: 0.75;
}

.metric-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.metric-cell {
  min-height: 126rpx;
  padding: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e0e5e2;
  border-radius: 10rpx;
}

.metric-cell__head {
  display: flex;
  align-items: center;
  gap: 9rpx;
  color: #77817c;
  font-size: 21rpx;
}

.metric-cell__head image {
  width: 26rpx;
  height: 26rpx;
}

.metric-cell__value {
  display: block;
  margin-top: 13rpx;
  color: #202a25;
  font-size: 34rpx;
  font-weight: 700;
}

.metric-cell__unit {
  margin-left: 5rpx;
  color: #69736e;
  font-size: 20rpx;
  font-weight: 500;
}

.control-panel {
  padding: 24rpx;
}

.control-panel__head {
  margin-bottom: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.control-panel__title {
  font-weight: 700;
}

.control-panel__hint {
  color: #89928e;
  font-size: 20rpx;
}

.control-row {
  min-height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #edf0ee;
}

.control-row:first-of-type {
  border-top: 0;
}

.control-row__label {
  font-weight: 600;
}

.power-control {
  width: 148rpx;
  height: 60rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #68736d;
  background: #eef2f0;
  border-radius: 8rpx;
  font-size: 21rpx;
  font-weight: 600;
}

.power-control image {
  width: 26rpx;
  height: 26rpx;
  flex: 0 0 26rpx;
  opacity: 0.68;
}

.power-control--on {
  color: #ffffff;
  background: #13795b;
}

.power-control--on image {
  filter: brightness(0) invert(1);
  opacity: 1;
}

.power-control[disabled] {
  opacity: 0.42;
}

.segmented {
  display: flex;
  gap: 7rpx;
  padding: 6rpx;
  background: #eef2f0;
  border-radius: 9rpx;
}

.segment {
  min-width: 84rpx;
  height: 52rpx;
  padding: 0 12rpx;
  color: #66716b;
  background: transparent;
  border-radius: 7rpx;
  font-size: 21rpx;
}

.segment--active {
  color: #ffffff;
  background: #13795b;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stepper__button {
  width: 58rpx;
  height: 58rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef2f0;
  border-radius: 8rpx;
}

.stepper__button image {
  width: 26rpx;
  height: 26rpx;
}

.stepper__value {
  min-width: 74rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
}

.updated-at {
  padding: 24rpx 0 8rpx;
  color: #8b9490;
  text-align: center;
  font-size: 20rpx;
}
