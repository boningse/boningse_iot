.profile-identity {
  min-height: 130rpx;
  display: flex;
  align-items: center;
}

.profile-avatar {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #ffffff;
  background: #1d2a24;
  font-size: 40rpx;
  font-weight: 700;
}

.profile-copy {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.profile-name,
.profile-account {
  display: block;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 700;
}

.profile-account {
  margin-top: 6rpx;
  color: #7b8580;
  font-size: 22rpx;
}

.profile-role {
  padding: 9rpx 12rpx;
  color: #13795b;
  background: #e8f3ef;
  border-radius: 7rpx;
  font-size: 20rpx;
}

.scope-panel {
  margin-top: 30rpx;
  padding: 26rpx;
}

.scope-panel__label,
.scope-panel__value {
  display: block;
}

.scope-panel__label {
  color: #7b8580;
  font-size: 22rpx;
}

.scope-panel__value {
  margin: 8rpx 0 24rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.scope-row {
  padding-top: 22rpx;
  display: flex;
  justify-content: space-between;
  color: #69736e;
  font-size: 23rpx;
}

.scope-row__active {
  color: #13795b;
}

.action-list {
  overflow: hidden;
}

.action-row {
  min-height: 92rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
}

.action-row__icon {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: #eef2f0;
}

.action-row__icon--danger {
  background: #f9eaea;
}

.action-row__icon image {
  width: 30rpx;
  height: 30rpx;
}

.action-row__text {
  flex: 1;
  margin-left: 18rpx;
}

.action-row__arrow {
  width: 26rpx;
  height: 26rpx;
}

.action-row--danger {
  color: #a12d2d;
}

.password-panel {
  margin-top: 24rpx;
  padding: 26rpx;
}

.password-panel__head {
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  font-weight: 700;
}

.password-panel__close {
  height: auto;
  padding: 0;
  color: #78827d;
  background: transparent;
  font-size: 23rpx;
}

.version {
  padding: 46rpx 0 12rpx;
  color: #9aa39f;
  font-size: 20rpx;
  text-align: center;
}
