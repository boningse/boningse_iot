<view class="page profile-page">
  <view class="profile-identity">
    <view class="profile-avatar">{{initial}}</view>
    <view class="profile-copy">
      <text class="profile-name">{{displayName || "--"}}</text>
      <text class="profile-account">@{{account || "--"}}</text>
    </view>
    <view class="profile-role">{{roleText}}</view>
  </view>

  <view class="scope-panel panel">
    <text class="scope-panel__label">管理范围</text>
    <text class="scope-panel__value">{{scopeText}}</text>
    <view class="hairline"></view>
    <view class="scope-row">
      <text>所属租户</text>
      <text>{{tenantName}}</text>
    </view>
    <view class="scope-row">
      <text>账号状态</text>
      <text class="scope-row__active">正常</text>
    </view>
  </view>

  <view class="section-title">账号安全</view>
  <view class="action-list panel">
    <view class="action-row" bindtap="togglePasswordForm">
      <view class="action-row__icon">
        <image src="/assets/icons/key.png" mode="aspectFit"></image>
      </view>
      <text class="action-row__text">修改密码</text>
      <image class="action-row__arrow" src="/assets/icons/arrow-right.png" mode="aspectFit"></image>
    </view>
    <view class="hairline"></view>
    <view class="action-row action-row--danger" bindtap="logout">
      <view class="action-row__icon action-row__icon--danger">
        <image src="/assets/icons/logout.png" mode="aspectFit"></image>
      </view>
      <text class="action-row__text">退出登录</text>
    </view>
  </view>

  <view wx:if="{{showPasswordForm}}" class="password-panel panel">
    <view class="password-panel__head">
      <text>修改密码</text>
      <button class="password-panel__close" bindtap="togglePasswordForm">取消</button>
    </view>
    <view class="field">
      <text class="field-label">当前密码</text>
      <input class="field-input" password data-field="oldPassword" value="{{oldPassword}}" bindinput="onPasswordInput" />
    </view>
    <view class="field">
      <text class="field-label">新密码</text>
      <input class="field-input" password data-field="newPassword" value="{{newPassword}}" bindinput="onPasswordInput" />
    </view>
    <view class="field">
      <text class="field-label">确认新密码</text>
      <input class="field-input" password data-field="confirmPassword" value="{{confirmPassword}}" bindinput="onPasswordInput" />
    </view>
    <button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="changePassword">保存新密码</button>
  </view>

  <view class="version">伯宁智控 · 小程序 v0.1.0</view>
</view>
