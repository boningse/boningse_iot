<view class="page device-page">
  <view class="list-toolbar">
    <view class="list-search-box">
      <image src="/assets/icons/search.png" class="search-icon"></image>
      <input class="search-input" value="{{keyword}}" placeholder="名称、设备 ID" confirm-type="search" bindinput="onKeywordInput" bindconfirm="search" />
    </view>
    <button class="list-icon-button" bindtap="search" aria-label="刷新">
      <image src="/assets/icons/refresh.png" class="search-icon" mode="aspectFit"></image>
    </button>
  </view>

  <scope-filter bind:change="onScopeChange"></scope-filter>

  <view class="device-summary">
    <view class="bounary-line">
      <!-- <text class="page-title">照明控制</text>
      <text class="page-subtitle">照明回路与实时状态</text> -->
    </view>
  </view>

  <view wx:if="{{!loading && !devices.length}}">
    <empty-state  title="暂无照明设备" description="可在 PC 端设备管理中加入控制模块"></empty-state>
  </view>
  <view wx:else class="device-list">
    <view wx:for="{{devices}}" wx:for-index="deviceIndex" wx:key="routeId" class="device-card" data-index="{{deviceIndex}}" bindtap="openDetail">
      <view class="device-card__head">
        <view class="device-card__identity">
          <text class="device-card__name">{{item.viewName}}</text>
          <text class="device-card__code">{{item.viewCode}}</text>
        </view>
        <status-badge status="{{item.viewStatus}}"></status-badge>
      </view>
      <view class="device-card__location">
        <image src="/assets/icons/map.png" mode="aspectFit"></image>
        <text>{{item.viewBuilding}}</text>
        <view class="location-separator"></view>
        <text>{{item.viewGroup}}</text>
      </view>
      <view class="lighting-diagram">
        <view
          wx:for="{{item.circuits}}"
          wx:for-item="circuit"
          wx:for-index="circuitIndex"
          wx:key="key"
          class="lighting-circuit {{circuit.on ? 'lighting-circuit--on' : ''}}"
          data-device-index="{{deviceIndex}}"
          data-circuit-index="{{circuitIndex}}"
          catchtap="toggleCircuit"
        >
          <view class="lighting-circuit__lamp">
            <image src="/assets/icons/lighting.png" mode="aspectFit"></image>
          </view>
          <view class="lighting-circuit__copy">
            <text>{{circuit.label}}</text>
            <text>{{circuit.on ? "已开启" : "已关闭"}}</text>
          </view>
        </view>
      </view>
      <view class="device-card__footer">
        <view class="lighting-type">{{item.lighting_type === "triple" ? "三路" : item.lighting_type === "double" ? "双路" : "单路"}}照明</view>
        <button class="detail-link" data-index="{{deviceIndex}}" catchtap="openDetail">
          <text>详情</text>
          <image src="/assets/icons/arrow-right.png" mode="aspectFit"></image>
        </button>
      </view>
    </view>
  </view>
  <view wx:if="{{loading || loadingMore}}" class="load-footer">正在同步设备...</view>
  <view wx:else class="load-footer"><text class="numeric">设备总数：{{total}}</text>台</view>
</view>
