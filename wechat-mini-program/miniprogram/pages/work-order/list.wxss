.work-page {
  padding-top: 20rpx;
}

.summary-strip {
  height: 122rpx;
  margin-bottom: 20rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: #1d2a24;
  border-radius: 12rpx;
  overflow: hidden;
}

.summary-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
}

.summary-item + .summary-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 28rpx;
  bottom: 28rpx;
  width: 1rpx;
  background: #394740;
}

.summary-item--alert .summary-item__value {
  color: #f0a19a;
}

.summary-item__value {
  font-size: 34rpx;
  font-weight: 700;
}

.summary-item__label {
  margin-top: 5rpx;
  color: #aebbb5;
  font-size: 19rpx;
}

.order-tabs {
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.order-tabs__inner {
  display: inline-flex;
  gap: 8rpx;
  padding: 5rpx;
  background: #e8edeb;
  border-radius: 10rpx;
}

.order-tab {
  min-width: 132rpx;
  height: 58rpx;
  padding: 0 16rpx;
  color: #68736d;
  background: transparent;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.order-tab--active {
  color: #17211d;
  background: #ffffff;
  box-shadow: 0 3rpx 10rpx rgba(20, 40, 31, 0.08);
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-card {
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e0e5e2;
  border-radius: 12rpx;
}

.order-card__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.order-card__severity {
  padding: 7rpx 10rpx;
  color: #66716b;
  background: #eef1ef;
  border-radius: 6rpx;
  font-size: 19rpx;
}

.order-card__severity--critical {
  color: #ad3232;
  background: #fbeaea;
}

.order-card__severity--high {
  color: #a45b15;
  background: #fff1df;
}

.order-card__severity--medium {
  color: #356bb3;
  background: #eaf1fa;
}

.order-card__module {
  flex: 1;
  color: #74807a;
  font-size: 20rpx;
}

.order-card__title,
.order-card__message {
  display: block;
}

.order-card__title {
  margin-top: 20rpx;
  color: #202a25;
  font-size: 29rpx;
  font-weight: 680;
}

.order-card__message {
  margin-top: 9rpx;
  overflow: hidden;
  color: #737e78;
  font-size: 22rpx;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-card__device {
  margin-top: 18rpx;
  padding: 15rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #f4f6f5;
  border-radius: 8rpx;
  font-size: 21rpx;
}

.order-card__device image {
  width: 25rpx;
  height: 25rpx;
}

.order-card__location {
  margin-left: auto;
  color: #87908c;
}

.order-card__footer {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  color: #89928e;
  font-size: 19rpx;
}
