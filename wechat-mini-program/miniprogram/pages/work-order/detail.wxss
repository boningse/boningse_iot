.order-detail-page {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.order-overview {
  padding: 26rpx;
}

.order-overview__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #78827d;
  font-size: 20rpx;
}

.order-overview__head status-badge {
  margin-left: auto;
}

.order-overview__severity {
  padding: 7rpx 10rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 6rpx;
  background: #eef1ef;
}

.order-overview__severity--critical {
  color: #ad3232;
  background: #fbeaea;
}

.order-overview__severity--high {
  color: #a45b15;
  background: #fff1df;
}

.order-overview__severity--medium {
  color: #356bb3;
  background: #eaf1fa;
}

.order-overview__title,
.order-overview__message {
  display: block;
}

.order-overview__title {
  margin-top: 22rpx;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 700;
}

.order-overview__message {
  margin-top: 12rpx;
  color: #69736e;
  font-size: 23rpx;
  line-height: 1.6;
}

.order-device {
  margin-top: 24rpx;
  padding: 18rpx;
  display: flex;
  align-items: center;
  background: #f3f6f4;
  border-radius: 8rpx;
}

.order-device__icon {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e5ebe8;
  border-radius: 8rpx;
}

.order-device__icon image {
  width: 32rpx;
  height: 32rpx;
}

.order-device__copy {
  flex: 1;
  min-width: 0;
  margin-left: 15rpx;
}

.order-device__name,
.order-device__location {
  display: block;
}

.order-device__name {
  font-weight: 650;
}

.order-device__location {
  margin-top: 5rpx;
  color: #818b86;
  font-size: 20rpx;
}

.order-info {
  margin-top: 22rpx;
}

.order-info view {
  padding: 13rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #edf0ee;
  color: #7b8580;
  font-size: 21rpx;
}

.order-info view text:last-child {
  max-width: 65%;
  color: #303a35;
  text-align: right;
}

.workflow-panel {
  margin-top: 18rpx;
  padding: 24rpx;
}

.workflow-panel__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 25rpx;
  font-weight: 680;
}

.workflow-panel__head text:last-child {
  color: #13795b;
  font-size: 21rpx;
}

.workflow-steps {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.workflow-step {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9rpx;
  color: #929a96;
  font-size: 19rpx;
}

.workflow-step::before {
  content: "";
  position: absolute;
  top: 19rpx;
  right: 50%;
  left: -50%;
  height: 2rpx;
  background: #dfe5e2;
}

.workflow-step:first-child::before {
  display: none;
}

.workflow-step__marker {
  position: relative;
  z-index: 1;
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #d7dedb;
  border-radius: 50%;
  background: #ffffff;
  font-size: 18rpx;
}

.workflow-step--done,
.workflow-step--current {
  color: #13795b;
  font-weight: 650;
}

.workflow-step--done::before,
.workflow-step--current::before {
  background: #8ec4b1;
}

.workflow-step--done .workflow-step__marker {
  color: #ffffff;
  border-color: #13795b;
  background: #13795b;
}

.workflow-step--current .workflow-step__marker {
  border-color: #13795b;
  box-shadow: inset 0 0 0 7rpx #dcefe8;
}

.workflow-panel__hint {
  display: block;
  margin-top: 22rpx;
  padding: 15rpx 17rpx;
  color: #53625b;
  background: #f1f5f3;
  border-radius: 7rpx;
  font-size: 21rpx;
  line-height: 1.5;
}

.photo-strip {
  white-space: nowrap;
}

.photo-strip__inner {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 24rpx;
}

.order-photo {
  width: 200rpx;
  height: 150rpx;
  border-radius: 8rpx;
  background: #e5eae7;
}
.timeline{
  padding-bottom: 260rpx;
}
.timeline-item {
  display: flex;
}

.timeline-item__axis {
  width: 42rpx;
  position: relative;
  flex: 0 0 auto;
}

.timeline-item__dot {
  width: 15rpx;
  height: 15rpx;
  margin: 26rpx auto 0;
  border: 4rpx solid #d3e7df;
  border-radius: 50%;
  background: #13795b;
}

.timeline-item__line {
  position: absolute;
  top: 45rpx;
  bottom: 0;
  left: 20rpx;
  width: 2rpx;
  background: #dce3df;
}

.timeline-item:last-child .timeline-item__line {
  display: none;
}

.timeline-item__content {
  flex: 1;
  min-width: 0;
  margin-bottom: 14rpx;
  padding: 20rpx;
}

.timeline-item__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-weight: 650;
}

.timeline-item__head text:last-child {
  color: #8b9490;
  font-size: 19rpx;
  font-weight: 400;
}

.timeline-item__operator {
  display: block;
  margin-top: 6rpx;
  color: #77817c;
  font-size: 20rpx;
}

.timeline-item__note {
  display: block;
  margin-top: 13rpx;
  padding: 13rpx;
  color: #4f5a54;
  background: #f3f6f4;
  border-radius: 7rpx;
  font-size: 21rpx;
  line-height: 1.55;
}

.timeline-item__photos {
  margin-top: 12rpx;
  color: #356bb3;
  font-size: 20rpx;
}

.timeline-empty {
  padding: 50rpx 0;
  color: #8b9490;
  text-align: center;
}

.action-dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #e0e5e2;
}

.action-dock__inner {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.action-button {
  flex: 1 1 150rpx;
  min-width: 0;
  height: 70rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9rpx;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1.2;
}

.action-button--primary {
  flex-basis: 100%;
  color: #ffffff;
  background: #13795b;
}

.action-button--secondary {
  color: #345247;
  background: #e8f0ed;
}

.action-button--danger {
  color: #a12d2d;
  background: #fbeaea;
}
