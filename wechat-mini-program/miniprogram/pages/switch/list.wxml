<view class="page device-page">
  <view class="list-toolbar">
    <view class="list-search-box">
      <image src="/assets/icons/search.png" class="search-icon"></image>
      <input class="search-input" value="{{keyword}}" placeholder="名称、设备 ID" confirm-type="search" bindinput="onKeywordInput" bindconfirm="search" />
    </view>
    <button class="list-icon-button" bindtap="search" aria-label="搜索">
      <image src="/assets/icons/refresh.png" class="search-icon"></image>
    </button>
  </view>

  <scope-filter bind:change="onScopeChange"></scope-filter>

  <view class="device-summary">
    <view class="bounary-line">
      <!-- <text class="page-title">开关控制</text>
      <text class="page-subtitle">定时开关统一控制</text> -->
    </view>

  </view>

  <view wx:if="{{!loading && !devices.length}}">
    <empty-state  title="暂无开关设备" description="可在 PC 端设备管理中加入控制模块"></empty-state>
  </view>
  <view wx:else class="device-list">
    <view
      wx:for="{{devices}}"
      wx:key="routeId"
      class="device-card"
      data-index="{{index}}"
      bindtap="openDetail"
    >
      <view class="device-card__head">
        <view class="device-card__identity">
          <text class="device-card__name">{{item.viewName}}</text>
          <text class="device-card__code">{{item.viewCode}}</text>
        </view>
        <status-badge status="{{item.viewStatus}}"></status-badge>
      </view>
      <view class="device-card__location">
        <image src="/assets/icons/map.png" mode="aspectFit"></image>
        <text>{{item.viewBuilding}}</text>
        <view class="location-separator"></view>
        <text>{{item.viewGroup}}</text>
      </view>
      <view class="device-card__footer">
        <button
          class="power-control {{item.powerOn ? 'power-control--on' : ''}}"
          disabled="{{!item.online || controllingId}}"
          data-id="{{item.routeImei}}"
          data-index="{{index}}"
          catchtap="togglePower"
        >
          <image src="/assets/icons/power.png" mode="aspectFit"></image>
          <text>{{item.powerOn ? "已开启" : "已关闭"}}</text>
        </button>
        <button class="detail-link" data-index="{{index}}" catchtap="openDetail">
          <text>详情</text>
          <image src="/assets/icons/arrow-right.png" mode="aspectFit"></image>
        </button>
      </view>
    </view>
  </view>
  <view wx:if="{{loading || loadingMore}}" class="load-footer">正在同步设备...</view>
  <view wx:elif="{{devices.length && page >= totalPages}}" class="load-footer"><text class="numeric">设备总数：{{total}}</text>台</view>
</view>
