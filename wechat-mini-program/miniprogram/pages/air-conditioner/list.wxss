@import "../../styles/device-list.wxss";

.card-actions {
  display: flex;
  gap: 10rpx;
}

.card-actions .detail-link {
  width: 58rpx;
  padding: 0;
  justify-content: center;
}

.search-icon{
  width:30rpx;
  height:30rpx;
}
.bounary-line{
  width:100%;
  height:1rpx;
  border-bottom: 1px solid #ccc;
  margin:15rpx 0;
}
.list-toolbar {
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin-bottom: 20rpx;
}
.list-search-box{
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border: 1rpx solid #dde3df;
  border-radius: 10rpx;
}
.list-icon-button{
  width: 22rpx;
  height: 68rpx;
  padding: 0;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef2f0;
}
