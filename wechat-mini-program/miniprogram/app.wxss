page {
  min-height: 100%;
  background: #f4f6f5;
  color: #17211d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}

view,
text,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  font-size: 28rpx;
  letter-spacing: 0;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.page-head {
  margin-bottom: 28rpx;
}

.page-title {
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #17211d;
}

.page-subtitle {
  margin-top: 8rpx;
  color: #6d7772;
  font-size: 24rpx;
  line-height: 1.5;
}

.section-title {
  margin: 32rpx 0 16rpx;
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #303a35;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #e1e6e3;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(25, 45, 36, 0.045);
}

.hairline {
  height: 1rpx;
  background: #e9edeb;
}

.muted {
  color: #79837e;
}

.caption {
  color: #7b8580;
  font-size: 22rpx;
}

.numeric {
  font-variant-numeric: tabular-nums;
}

.primary-button,
.secondary-button,
.danger-button {
  height: 80rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.primary-button {
  color: #ffffff;
  background: #13795b;
}

.secondary-button {
  color: #204c3d;
  background: #e8f3ef;
}

.danger-button {
  color: #a12d2d;
  background: #fbeaea;
}

.primary-button[disabled],
.secondary-button[disabled],
.danger-button[disabled] {
  opacity: 0.48;
}

.icon-button {
  width: 68rpx;
  height: 68rpx;
  padding: 0;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef2f0;
}

.icon-button image {
  width: 34rpx;
  height: 34rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #4d5752;
  font-size: 24rpx;
  font-weight: 600;
}

.field-input,
.field-textarea,
.picker-field {
  width: 100%;
  min-height: 82rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #d9dfdc;
  border-radius: 10rpx;
  background: #ffffff;
  color: #17211d;
}

.field-textarea {
  min-height: 180rpx;
  line-height: 1.55;
}

.field-placeholder {
  color: #a1aaa5;
}

.toolbar {
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin-bottom: 20rpx;
}

.search-box {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border: 1rpx solid #dde3df;
  border-radius: 10rpx;
}

.search-box image {
  width: 30rpx;
  height: 30rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
}

.load-footer {
  padding: 28rpx 0 8rpx;
  text-align: center;
  color: #89928e;
  font-size: 22rpx;
}

.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}
