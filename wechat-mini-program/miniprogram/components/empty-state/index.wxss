.empty {
  padding: 96rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty__mark {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #cfd7d3;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
  padding: 0 18rpx;
}

.empty__line {
  height: 4rpx;
  border-radius: 2rpx;
  background: #cfd7d3;
}

.empty__line--short {
  width: 60%;
}

.empty__title {
  color: #3d4742;
  font-weight: 600;
}

.empty__description {
  margin-top: 8rpx;
  color: #89928e;
  font-size: 23rpx;
  line-height: 1.5;
}
