.filters {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.filters__inner {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 24rpx;
}

.filter-chip {
  height: 64rpx;
  width:225rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  /* gap: 70rpx; */
  justify-content: space-between;
  color: #626d67;
  background: #ffffff;
  border: 1rpx solid #dce2df;
  border-radius: 8rpx;
  font-size: 23rpx;
}

.filter-chip text {
  overflow: hidden;
  text-overflow: ellipsis;
}

.filter-chip image {
  flex: 0 0 auto;
  width: 24rpx;
  height: 24rpx;
}

.filter-chip--active {
  color: #136f54;
  background: #e9f4f0;
  border-color: #b9ddcf;
}

.filter-reset {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef2f0;
  border-radius: 8rpx;
}

.filter-reset image {
  width: 28rpx;
  height: 28rpx;
}
